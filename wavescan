#!/bin/sh
# Wrapper: run wavescan.py with system python if audiofile/Jinja2 are
# importable, otherwise let uv provide an environment with them.
set -eu
dir=$(dirname "$(readlink -f "$0")")

if python3 -c 'import audiofile, jinja2' 2>/dev/null; then
    exec python3 "$dir/wavescan.py" "$@"
fi

if command -v uv >/dev/null 2>&1; then
    exec uv run -q --no-project \
        --with-requirements "$dir/requirements.txt" \
        -- python3 "$dir/wavescan.py" "$@"
fi

echo "wavescan: modules audiofile/Jinja2 not found and uv is not installed" >&2
echo "either 'pip install -r $dir/requirements.txt'" >&2
echo "or install uv: https://docs.astral.sh/uv/" >&2
exit 1
